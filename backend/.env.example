# NovaPay Services — Environment Variables
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgresql://user:password@localhost:5432/novapay_services
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Crypto receiving addresses (PUBLIC ONLY - NO PRIVATE KEYS!)
BTC_ADDRESS=bc1ql9j624q07ml9xpccx7t79hu9khcleyy03x9pxv
ETH_ADDRESS=0x06C4A6cE5f5D318dc92855B187Ea684D2663a20D
LTC_ADDRESS=ltc1qnh8gfs265dag0g6wn88f5sdxlra7ersg6tp2vs
DOGE_ADDRESS=DHC3A7uncFJpCMucx7ZFpT4gMCpRrSkfKz
USDT_TRC20_ADDRESS=TSfgvTAC1z6gnKjc6CDYL5YAFL8pxU5CMv

# Blockchain APIs
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
TRONGRID_API_KEY=YOUR_TRONGRID_API_KEY

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@novapay.services
SMTP_PASS=CHANGE_THIS
EMAIL_FROM=NovaPay Services <noreply@novapay.services>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=https://novapay.services

WEBHOOK_SECRET=CHANGE_THIS
ADMIN_SETUP_KEY=CHANGE_THIS